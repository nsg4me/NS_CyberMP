{
  "name": "CyberpunkMP",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:electron": "cross-env ELECTRON_DEV=1 electron .",
    "build:electron": "electron-builder --publish=never"
  },
  "author": {
    "name": "Tilted Phoques SRL"
  },
  "productName": "CyberpunkMP",
  "build": {
    "productName": "CyberpunkMP",
    "includeSubNodeModules": "true",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "app.js",
      "host.js",
      "deps.js",
      "updater.js",
      "tools.js",
      "upnp.js",
      "preload.mjs",
      "package.json"
    ],
    "extraResources": [
      "preload.mjs"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir",
      "category": "Game"
    }
  },
  "private": true,
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "react-devtools": "^6.0.1"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "decompress": "^4.2.1",
    "electron-store": "^10.0.0",
    "readable-stream": "^4.5.2"
  }
}
